# URL pública del proyecto, disponible en Supabase > Connect.
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable recomendada (sb_publishable_...). Es segura en el navegador con RLS activo.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Compatibilidad opcional con proyectos que aún usan la clave anon heredada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
